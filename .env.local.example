# Banco de dados
# Neon (produção): connection string em Connection Details no painel do Neon.
DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"
# Alternativa local sem Neon (Postgres embutido): rode db:migrate e db:seed depois de trocar.
# DATABASE_URL="pglite:./.data/dev"

# Autenticação (obrigatório). Gere com: npx auth secret
AUTH_SECRET=""

# Assina os links de agendamento enviados às clientes. Se vazio, usa AUTH_SECRET.
TOKEN_SECRET=""

# Endereço público do sistema, usado nos links das mensagens.
APP_URL="http://localhost:3000"

# Única conta administradora, criada ou atualizada por `npm run db:seed-admin`.
ADMIN_EMAIL="admin@nailagenda.com"
ADMIN_USERNAME="Erika"
ADMIN_NAME="Erika"
ADMIN_PASSWORD=""

# Mensagens para as clientes (link do agendamento, confirmação, lembrete e código de acesso).
# "log" só registra no console; "webhook" envia um POST JSON para NOTIFY_WEBHOOK_URL,
# que pode repassar para WhatsApp/SMS (Z-API, Twilio, n8n...).
NOTIFY_DRIVER="log"
NOTIFY_WEBHOOK_URL=""
NOTIFY_WEBHOOK_SECRET=""

# Protege /api/cron/reminders (a Vercel envia Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# Avisos de novos agendamentos nos dispositivos da administradora (Web Push).
# Gere uma única vez com: npx web-push generate-vapid-keys
# Mantenha o mesmo par nas próximas publicações. Nunca exponha a chave privada.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# E-mail de contato real no formato mailto: ou endereço HTTPS público.
VAPID_SUBJECT="mailto:admin@seu-dominio.com"
